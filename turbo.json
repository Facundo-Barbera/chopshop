{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "pnpm-workspace.yaml",
    ".gitignore"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!test/**",
        "!tests/**"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "check": {
      "inputs": [
        "$TURBO_DEFAULT$"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "app": {
      "dependsOn": [
        "@chopshop/ui#build"
      ],
      "cache": false
    }
  }
}
