{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "Resources/web/**"
      ]
    },
    "check": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "app": {
      "dependsOn": [
        "@chopshop/ui#build"
      ],
      "cache": false
    }
  }
}
