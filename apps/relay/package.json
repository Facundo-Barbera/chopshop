{
  "name": "@chopshop/relay",
  "private": true,
  "version": "0.9.0",
  "description": "Relay de chopshop en Cloudflare Workers con un Durable Object (Hub).",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --experimental-transform-types --experimental-sqlite --no-warnings --import ./test/register.mjs --test \"test/*.test.ts\"",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  }
}
