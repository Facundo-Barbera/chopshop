{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chopshop.local/backend/v2/idn/invitations.post.request.schema.json",
  "title": "POST /v1/invitations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "email",
    "workspace_ids"
  ],
  "properties": {
    "email": {
      "$ref": "../common.schema.json#/$defs/email"
    },
    "workspace_ids": {
      "type": "array",
      "items": {
        "$ref": "../common.schema.json#/$defs/uuid"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "ttl_h": {
      "$ref": "../common.schema.json#/$defs/ttl_h"
    }
  }
}
