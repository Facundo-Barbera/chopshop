{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chopshop.local/backend/v2/idn/auth-login.post.request.schema.json",
  "title": "POST /v1/auth/login",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "email",
    "password",
    "device_name",
    "client"
  ],
  "properties": {
    "email": {
      "$ref": "../common.schema.json#/$defs/email"
    },
    "password": {
      "$ref": "../common.schema.json#/$defs/password"
    },
    "device_name": {
      "$ref": "../common.schema.json#/$defs/device_name"
    },
    "client": {
      "$ref": "../common.schema.json#/$defs/client"
    }
  }
}
