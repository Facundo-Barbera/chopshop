{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chopshop.local/backend/v2/str/projects-id.patch.request.schema.json",
  "title": "PATCH /v1/projects/{id}",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rev"
  ],
  "properties": {
    "rev": {
      "$ref": "../common.schema.json#/$defs/rev"
    },
    "workspace_id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "disabled": {
      "type": "boolean"
    },
    "name": {
      "$ref": "../common.schema.json#/$defs/name"
    },
    "title": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 120
        },
        {
          "type": "null"
        }
      ]
    },
    "t3_project": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "repo": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "machine_id": {
      "oneOf": [
        {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "runtime_mode": {
      "$ref": "../common.schema.json#/$defs/runtime_mode"
    },
    "model": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        {
          "type": "null"
        }
      ]
    },
    "settings": {
      "$ref": "../common.schema.json#/$defs/json_object"
    }
  }
}
