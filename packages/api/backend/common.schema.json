            }
          ]
        },
        "dismissed_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "import_project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "company",
        "t3_project",
        "repo",
        "roles",
        "floors",
        "has_prompts",
        "conflicts"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "company": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "t3_project": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "repo": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "uniqueItems": true
        },
        "floors": {
          "$ref": "#/$defs/count"
        },
        "has_prompts": {
          "type": "boolean"
        },
        "conflicts": {
          "type": "array",
          "items": {
            "enum": [
              "name_taken"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "audit_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "at",
        "actor_kind",
        "actor_user_id",
        "session_id",
        "machine_id",
        "action",
        "target_kind",
        "target_id",
        "command",
        "result",
        "status",
        "detail"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "at": {
          "$ref": "#/$defs/time"
        },
        "actor_kind": {
          "enum": [
            "user",
            "operator",
            "machine",
            "system"
          ]
        },
        "actor_user_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "machine_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "enum": [
            "auth.login",
            "auth.login_failed",
            "auth.logout",
            "auth.password_changed",
            "auth.recovered",
            "auth.recovery_code_regenerated",
            "session.revoked",
            "user.disabled",
            "user.enabled",
            "invitation.created",
            "invitation.reissued",
            "invitation.revoked",
            "invitation.accepted",
            "operator.bootstrap",
            "operator.recover",
            "machine.linked",
            "machine.token_issued",
            "machine.paused",
            "machine.resumed",
            "machine.revoked",
            "workspace.shared",
            "workspace.unshared",
            "import.applied",
            "command"
          ]
        },
        "target_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "oneOf": [
            {
              "$ref": "#/$defs/command_name"
            },
            {
              "type": "null"
            }
          ]
        },
        "result": {
          "enum": [
            "ok",
            "denied",
            "error",
            "timeout"
          ]
        },
        "status": {
          "type": [
            "integer",
            "null"
          ]
        },
        "detail": {
          "$ref": "#/$defs/json_object"
        }
      }
    },
    "pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "severity": {
      "enum": [
        "info",
        "notice",
        "warn",
        "error"
      ]
    },
    "needs": {
      "enum": [
        null,
        "human",
        "bot",
        "approval"
      ]
    },
    "subject_kind": {
      "enum": [
        "task",
        "batch",
        "node",
        "graph",
        "thread",
        "machine",
        "pr",
        "issue",
        "automation",
        "agent",
        "desk",
        "office",
        "repo",
        "run",
        "listener"
      ]
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "media_type",
        "enc",
        "bytes",
        "sha256",
        "data"
      ],
      "properties": {
        "name": {
          "enum": [
            "state",
            "queue",
            "events",
            "office",
            "employees",
            "body"
          ]
        },
        "media_type": {
          "const": "application/json"
        },
        "enc": {
          "enum": [
            "none",
            "e2e-v1"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 786432
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "data": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]*={0,2}$",
          "maxLength": 1048576
        }
      }
    }
  }
}
