        },
        "token": {
          "$ref": "#/$defs/session_token"
        },
        "recovery_code": {
          "$ref": "#/$defs/recovery_code"
        }
      }
    },
    "login_web": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user",
        "session",
        "csrf_token"
      ],
      "properties": {
        "user": {
          "$ref": "#/$defs/user"
        },
        "session": {
          "$ref": "#/$defs/session_brief"
        },
        "csrf_token": {
          "$ref": "#/$defs/csrf_token"
        },
        "recovery_code": {
          "$ref": "#/$defs/recovery_code"
        }
      }
    },
    "import_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "machine_id",
        "created_at",
        "summary",
        "applied_at",
        "dismissed_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "machine_id": {
          "$ref": "#/$defs/uuid"
        },
        "created_at": {
          "$ref": "#/$defs/time"
        },
        "summary": {
          "type": "array"
        },
        "applied_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/time"
            },
            {
