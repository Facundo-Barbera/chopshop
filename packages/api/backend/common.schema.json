            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "match_rules": {
          "$ref": "#/$defs/json_object"
        },
        "wake": {
          "type": "array"
        },
        "settings": {
          "$ref": "#/$defs/json_object"
        },
        "position": {
          "$ref": "#/$defs/count"
        },
        "rev": {
          "$ref": "#/$defs/rev"
        },
        "created_at": {
          "$ref": "#/$defs/time"
        },
        "updated_at": {
          "$ref": "#/$defs/time"
        }
      }
    },
    "campus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
