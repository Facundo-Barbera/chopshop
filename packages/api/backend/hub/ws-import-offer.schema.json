{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chopshop.local/backend/v2/hub/ws-import-offer.schema.json",
  "title": "WS v2 import.offer: perfiles locales (agente → relay)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "id",
    "ts",
    "projects"
  ],
  "properties": {
    "v": {
      "$ref": "../common.schema.json#/$defs/v"
    },
    "id": {
      "$ref": "../common.schema.json#/$defs/msg_id"
    },
    "ts": {
      "$ref": "../common.schema.json#/$defs/ts"
    },
    "type": {
      "const": "import.offer"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "project"
        ],
        "properties": {
          "project": {
            "$ref": "../common.schema.json#/$defs/name"
          },
          "registry": {
            "$ref": "../common.schema.json#/$defs/json_object"
          }
        }
      },
      "minItems": 1,
      "maxItems": 256
    }
  }
}
