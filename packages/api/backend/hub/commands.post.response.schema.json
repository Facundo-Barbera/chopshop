{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chopshop.local/backend/v2/hub/commands.post.response.schema.json",
  "title": "POST /v1/commands → 200 (DESPUÉS)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command_id",
    "ok",
    "status",
    "body"
  ],
  "properties": {
    "command_id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "ok": {
      "type": "boolean"
    },
    "status": {
      "type": "integer",
      "minimum": 100,
      "maximum": 599
    },
    "body": {}
  }
}
