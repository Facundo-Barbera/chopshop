{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chopshop.local/backend/v2/hub/ws-cmd.schema.json",
  "title": "WS v2 cmd (relay → agente, DESPUÉS)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "id",
    "ts",
    "command_id",
    "name",
    "args"
  ],
  "properties": {
    "v": {
      "$ref": "../common.schema.json#/$defs/v"
    },
    "id": {
      "$ref": "../common.schema.json#/$defs/msg_id"
    },
    "ts": {
      "$ref": "../common.schema.json#/$defs/ts"
    },
    "type": {
      "const": "cmd"
    },
    "command_id": {
      "$ref": "../common.schema.json#/$defs/uuid"
    },
    "name": {
      "$ref": "../common.schema.json#/$defs/command_name"
    },
    "args": {}
  }
}
