{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chopshop.local/backend/v2/hub/ws-snapshot.schema.json",
  "title": "WS v2 snapshot: uno por workspace (agente → relay → visor)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "id",
    "ts",
    "machine_id",
    "workspace_id",
    "seq",
    "ttl_s",
    "agent_version",
    "health",
    "counts",
    "projects",
    "parts"
  ],
  "properties": {
    "v": {
      "$ref": "../common.schema.json#/$defs/v"
    },
    "id": {
      "$ref": "../common.schema.json#/$defs/msg_id"
    },
    "ts": {
      "$ref": "../common.schema.json#/$defs/ts"
    },
    "type": {
      "const": "snapshot"
    },
    "machine_id": {
      "$ref": "../common.schema.json#/$defs/local_machine_id"
    },
    "workspace_id": {
      "oneOf": [
        {
          "$ref": "../common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "seq": {
      "$ref": "../common.schema.json#/$defs/count"
    },
    "ttl_s": {
      "type": "integer",
      "minimum": 30,
      "maximum": 900
    },
    "agent_version": {
      "$ref": "../common.schema.json#/$defs/version"
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "t3_ok",
        "cpu_pct",
        "ram_pct",
        "disk_pct",
        "load1"
      ],
      "properties": {
        "state": {
          "enum": [
            "ok",
            "degraded",
            "down"
          ]
        },
        "t3_ok": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "cpu_pct": {
          "$ref": "../common.schema.json#/$defs/pct"
        },
        "ram_pct": {
          "$ref": "../common.schema.json#/$defs/pct"
        },
        "disk_pct": {
          "$ref": "../common.schema.json#/$defs/pct"
        },
        "load1": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "running": {
          "$ref": "../common.schema.json#/$defs/count"
        },
        "queued": {
          "$ref": "../common.schema.json#/$defs/count"
        },
        "waiting": {
          "$ref": "../common.schema.json#/$defs/count"
        },
        "stuck": {
          "$ref": "../common.schema.json#/$defs/count"
        },
        "needs_human": {
          "$ref": "../common.schema.json#/$defs/count"
        },
        "waiting_bot": {
          "$ref": "../common.schema.json#/$defs/count"
        },
        "done": {
          "$ref": "../common.schema.json#/$defs/count"
        },
        "failed": {
          "$ref": "../common.schema.json#/$defs/count"
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "roles",
          "threads_running",
          "threads_pending",
          "attention"
        ],
        "properties": {
          "name": {
            "$ref": "../common.schema.json#/$defs/name"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "../common.schema.json#/$defs/name"
            },
            "maxItems": 64,
            "uniqueItems": true
          },
          "threads_running": {
            "$ref": "../common.schema.json#/$defs/count"
          },
          "threads_pending": {
            "$ref": "../common.schema.json#/$defs/count"
          },
          "attention": {
            "$ref": "../common.schema.json#/$defs/count"
          }
        }
      },
      "maxItems": 256
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "../common.schema.json#/$defs/part"
      },
      "maxItems": 8
    }
  }
}
