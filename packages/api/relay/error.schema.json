{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chopshop.local/relay/v1/error.schema.json",
  "title": "error: fallo de un mensaje o de una petición HTTP (relay -> cliente)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "id",
    "ts",
    "code",
    "message"
  ],
  "properties": {
    "v": {
      "$ref": "common.schema.json#/$defs/v"
    },
    "type": {
      "const": "error"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/msg_id"
    },
    "ts": {
      "$ref": "common.schema.json#/$defs/ts"
    },
    "re": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/msg_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "code": {
      "enum": [
        "bad_request",
        "unauthorized",
        "forbidden",
        "not_found",
        "gone",
        "conflict",
        "too_large",
        "rate_limited",
        "unsupported_version",
        "internal"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "retry_after_s": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "close": {
      "type": "boolean"
    }
  }
}
