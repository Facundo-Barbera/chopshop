{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chopshop.local/relay/v1/welcome.schema.json",
  "title": "welcome: el relay acepta el hello (relay -> agente)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "id",
    "ts",
    "re",
    "session_id",
    "protocol",
    "snapshot_ttl_s",
    "max_frame_bytes",
    "ping_interval_s"
  ],
  "properties": {
    "v": {
      "$ref": "common.schema.json#/$defs/v"
    },
    "type": {
      "const": "welcome"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/msg_id"
    },
    "ts": {
      "$ref": "common.schema.json#/$defs/ts"
    },
    "re": {
      "$ref": "common.schema.json#/$defs/msg_id"
    },
    "session_id": {
      "type": "string",
      "pattern": "^ss-[0-9a-f]{16}$"
    },
    "protocol": {
      "const": 1
    },
    "snapshot_ttl_s": {
      "type": "integer",
      "minimum": 30,
      "maximum": 900
    },
    "max_frame_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 1048576
    },
    "ping_interval_s": {
      "type": "integer",
      "minimum": 5,
      "maximum": 300
    }
  }
}
