{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chopshop.local/relay/v1/state.schema.json",
  "title": "GET /state: máquinas de la cuenta (online/stale) y sus últimos snapshots vivos (relay -> visor, HTTP JSON)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "id",
    "ts",
    "head",
    "machines",
    "snapshots"
  ],
  "properties": {
    "v": {
      "$ref": "common.schema.json#/$defs/v"
    },
    "type": {
      "const": "state"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/msg_id"
    },
    "ts": {
      "$ref": "common.schema.json#/$defs/ts"
    },
    "head": {
      "$ref": "common.schema.json#/$defs/stream_id"
    },
    "machines": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "machine_id",
          "online",
          "stale",
          "seq",
          "snapshot_age_s",
          "expires_at"
        ],
        "properties": {
          "machine_id": {
            "$ref": "common.schema.json#/$defs/machine_id"
          },
          "online": {
            "type": "boolean"
          },
          "stale": {
            "type": "boolean"
          },
          "seq": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/count"
              },
              {
                "type": "null"
              }
            ]
          },
          "snapshot_age_s": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/count"
              },
              {
                "type": "null"
              }
            ]
          },
          "expires_at": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/ts"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "snapshots": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "snapshot.schema.json"
      }
    }
  }
}
