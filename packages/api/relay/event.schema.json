{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chopshop.local/relay/v1/event.schema.json",
  "title": "event: un sobre v1 reducido; el cuerpo viaja opaco (agente -> relay -> visor)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "type",
    "id",
    "ts",
    "machine_id",
    "event_id",
    "seq",
    "event_ts",
    "project",
    "event_type",
    "severity",
    "needs",
    "subject",
    "body"
  ],
  "properties": {
    "v": {
      "$ref": "common.schema.json#/$defs/v"
    },
    "type": {
      "const": "event"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/msg_id"
    },
    "ts": {
      "$ref": "common.schema.json#/$defs/ts"
    },
    "machine_id": {
      "$ref": "common.schema.json#/$defs/machine_id"
    },
    "event_id": {
      "$ref": "common.schema.json#/$defs/msg_id"
    },
    "seq": {
      "$ref": "common.schema.json#/$defs/count"
    },
    "event_ts": {
      "$ref": "common.schema.json#/$defs/ts"
    },
    "project": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/name"
        },
        {
          "type": "null"
        }
      ]
    },
    "event_type": {
      "$ref": "common.schema.json#/$defs/event_type"
    },
    "severity": {
      "$ref": "common.schema.json#/$defs/severity"
    },
    "needs": {
      "$ref": "common.schema.json#/$defs/needs"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "$ref": "common.schema.json#/$defs/subject_kind"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:#@-]([A-Za-z0-9_.:#@/-]{0,127})$"
        }
      }
    },
    "body": {
      "$ref": "common.schema.json#/$defs/part"
    }
  }
}
