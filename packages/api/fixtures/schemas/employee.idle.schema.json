{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chopshop.local/schemas/employee.idle.schema.json",
  "title": "employee.idle",
  "type": "object",
  "required": [
    "v",
    "id",
    "seq",
    "ts",
    "machine",
    "project",
    "type",
    "severity",
    "needs",
    "subject",
    "cause",
    "body"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "seq": {
      "type": [
        "integer",
        "null"
      ]
    },
    "ts": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(\\.\\d{1,6})?Z$"
    },
    "machine": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "employee.idle"
    },
    "severity": {
      "enum": [
        "info",
        "warn"
      ]
    },
    "needs": {
      "const": null
    },
    "subject": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "desk"
        },
        "id": {
          "type": "string",
          "pattern": "^[^/\\s]+/[0-9]+/[a-z0-9][a-z0-9_-]{0,31}/[0-9]+$"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "cause": {
      "type": "object",
      "required": [
        "id",
        "depth"
      ],
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        }
      }
    },
    "body": {
      "type": "object",
      "required": [
        "employee",
        "role",
        "reason",
        "thread_id",
        "since"
      ],
      "properties": {
        "employee": {
          "type": "string",
          "pattern": "^[^/\\s]+/[0-9]+/[a-z0-9][a-z0-9_-]{0,31}/[0-9]+$"
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
        },
        "reason": {
          "enum": [
            "done",
            "failed",
            "cancelled",
            "released",
            "retired"
          ]
        },
        "thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "since": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(\\.\\d{1,6})?Z$"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "queue_len": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
